layout {

    focus-ring {
        active-color   "#d3c0db"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d3c0db"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#d3c0db"
        inactive-color "#1a0f22"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#d3c0db80"
    }
}

recent-windows {
    highlight {
        active-color "#d3c0db"
        urgent-color "#ffb4ab"
    }
}
